# Python cache and test cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Build and packaging outputs
build/
dist/
*.egg-info/

# IDE and local tool state
.idea/
.vscode/
.codex_tmp/

# cryoROLE local outputs
cryorole_outputs/
selection_out/
alignments/

# Historical archives and local bundles
*.zip
*.rar
*.7z

# Large cryo-EM metadata/map files and local data products
*.mrc
*.map
*.cs
*.star

# Data-derived test fixtures stay local until the public tutorial datasets are
# released; tests that need them are skipped (see tests/conftest.py).
/tests/fixtures/
# Future public examples may opt in explicitly, for example:
#!examples/**

# OS files
.DS_Store
Thumbs.db

# Internal authoring documents are maintained outside the public checkout.
/docs/AGENTS.md
/docs/architecture.md
/docs/production_run_plan.md
/docs/roadmap.md
/docs/github_release_file_list.md
/docs/codex_prompt_*.md
